---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { format } from 'date-fns';
import { ptBR } from 'date-fns/locale';
import { Separator } from '../components/ui/separator';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const heroPost = sortedPosts[0];
const otherPosts = sortedPosts.slice(1);
---

<Layout title="GospelReads - The Intellectual Archive">
    <!-- Section Header -->
    <div class="mb-8 border-b-2 border-black pb-2 flex justify-between items-end">
        <h2 class="font-serif text-3xl md:text-4xl font-bold uppercase tracking-tighter">Últimas Publicações</h2>
        <span class="text-sm font-sans font-medium text-slate-500 uppercase tracking-widest">{format(new Date(), "dd 'de' MMMM, yyyy", { locale: ptBR })}</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12">
        <!-- Main Content Area (Hero) -->
        <div class="lg:col-span-8 flex flex-col gap-6">
            {heroPost && (
                <article class="flex flex-col gap-4">
                    {heroPost.data.image && (
                        <a href={`/gospelreads/posts/${heroPost.id}`} class="block overflow-hidden group">
                            <img
                                src={`/gospelreads${heroPost.data.image}`}
                                alt={heroPost.data.image_alt || heroPost.data.title}
                                class="w-full h-auto aspect-video object-cover grayscale transition-transform duration-700 group-hover:scale-105"
                            />
                        </a>
                    )}
                    <div class="flex flex-col gap-2 pt-2">
                        <div class="flex items-center gap-2 text-xs font-sans text-slate-500 uppercase tracking-widest font-semibold">
                            <span>{format(heroPost.data.date, "dd MMM yyyy", { locale: ptBR })}</span>
                            {heroPost.data.authors && heroPost.data.authors.length > 0 && (
                                <>
                                    <span>&bull;</span>
                                    <span>Por {heroPost.data.authors[0]}</span>
                                </>
                            )}
                        </div>
                        <a href={`/gospelreads/posts/${heroPost.id}`} class="group">
                            <h3 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight group-hover:underline decoration-2 underline-offset-4">
                                {heroPost.data.title}
                            </h3>
                        </a>
                        <p class="font-sans text-lg md:text-xl text-slate-700 leading-relaxed mt-4 max-w-3xl">
                            {heroPost.data.description}
                        </p>
                    </div>
                </article>
            )}
        </div>

        <!-- Sidebar (Other Posts) -->
        <div class="lg:col-span-4 flex flex-col gap-6 pl-0 lg:pl-8 lg:border-l lg:border-slate-300">
            {otherPosts.map((post, index) => (
                <article class="flex flex-col gap-2">
                    {index > 0 && <Separator className="my-4 bg-slate-300" />}
                    <div class="flex flex-col gap-1">
                        <div class="text-[10px] font-sans text-slate-500 uppercase tracking-widest font-semibold mb-1">
                            {format(post.data.date, "dd MMM yyyy", { locale: ptBR })}
                            {post.data.authors && post.data.authors.length > 0 && ` • ${post.data.authors[0]}`}
                        </div>
                        <a href={`/gospelreads/posts/${post.id}`} class="group">
                            <h4 class="font-serif text-2xl font-bold leading-tight group-hover:underline decoration-1 underline-offset-2">
                                {post.data.title}
                            </h4>
                        </a>
                        <p class="font-sans text-sm text-slate-600 line-clamp-3 mt-2">
                            {post.data.description}
                        </p>
                    </div>
                </article>
            ))}
        </div>
    </div>
</Layout>
