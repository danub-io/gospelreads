---
import '../styles/global.css';

interface Props {
	title: string;
    description?: string;
}

const { title, description = "GospelReads - The Intellectual Archive" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
		<title>{title}</title>
        <!-- Google Fonts: Playfair Display for serif headings, Inter for sans-serif body -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#f9f9f9] text-[#1a1c1c] font-sans antialiased selection:bg-black selection:text-white min-h-screen flex flex-col">
        <header class="border-b border-slate-300 bg-[#f9f9f9]/90 backdrop-blur-sm sticky top-0 z-50">
            <div class="max-w-screen-lg mx-auto px-4 py-4 md:py-6 flex justify-between items-center">
                <a href="/gospelreads/" class="font-serif font-bold text-2xl tracking-tighter uppercase">
                    GospelReads
                </a>
                <nav class="hidden md:flex gap-6">
                    <a href="/gospelreads/" class="text-sm font-medium hover:text-black/70 transition-colors uppercase tracking-widest">Início</a>
                    <a href="/gospelreads/sobre" class="text-sm font-medium hover:text-black/70 transition-colors uppercase tracking-widest">Sobre</a>
                </nav>
            </div>
            <!-- Double thin line for editorial feel -->
            <div class="border-b border-slate-200 h-1"></div>
        </header>

		<main class="flex-grow w-full max-w-screen-lg mx-auto px-4 py-8 md:py-12">
			<slot />
		</main>

        <footer class="border-t border-slate-300 bg-white mt-12 py-12">
            <div class="max-w-screen-lg mx-auto px-4 text-center">
                <p class="font-serif text-2xl font-bold mb-4 uppercase tracking-tighter">GospelReads</p>
                <p class="text-sm text-slate-500 font-sans">&copy; {new Date().getFullYear()} GospelReads. The Intellectual Archive.</p>
            </div>
        </footer>
	</body>
</html>

<style is:global>
    :root {
        --font-serif: 'Playfair Display', serif;
        --font-sans: 'Inter', sans-serif;
    }
    h1, h2, h3, h4, h5, h6, .font-serif {
        font-family: var(--font-serif);
    }
    body, p, span, div, .font-sans {
        font-family: var(--font-sans);
    }
</style>
